NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Local MongoDB: mongodb://127.0.0.1:27017/fyp_management
# Atlas: paste your connection URI here, including a database name.
MONGODB_URI=
# Generate a signing secret with:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
# Development seed override; default FypDemo2026! is documented in README.
DEMO_PASSWORD=
# Groq free-tier compatible model. Supply your own key from console.groq.com/keys.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AI_MAX_TEXT_CHARS=16000

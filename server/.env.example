NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Local MongoDB: mongodb://127.0.0.1:27017/fyp_management
# Atlas: paste your connection URI here, including a database name.
MONGODB_URI=
# Generate a signing secret with:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
# Used only by npm run seed; supply a password of at least 12 characters.
DEMO_PASSWORD=
# Reserved for a later phase. No external AI requests in Phase 1.
XAI_API_KEY=
XAI_MODEL=
